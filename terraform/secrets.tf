# The Express session secret is generated by Terraform and stored encrypted
# in SSM Parameter Store. The instance reads it at deploy time; it is never
# written to Git or to GitHub.
resource "random_password" "session_secret" {
  length  = 48
  special = false
}

resource "aws_ssm_parameter" "session_secret" {
  name  = "/${var.project}/session_secret"
  type  = "SecureString"
  value = random_password.session_secret.result
}
